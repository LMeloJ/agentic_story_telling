# Dynevi Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TTS Service Configuration
# Choose one TTS provider and configure accordingly

# Option 1: ElevenLabs (Cloud TTS)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Option 2: Google Cloud TTS
# GOOGLE_CLOUD_TTS_PROJECT_ID=your_project_id
# GOOGLE_CLOUD_TTS_CREDENTIALS_PATH=path/to/credentials.json

# Option 3: Azure Speech Services
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=your_azure_region

# Option 4: Offline TTS (pyttsx3) - No API key needed
# TTS_PROVIDER=pyttsx3

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# ChromaDB Configuration
CHROMADB_PATH=./data/chroma_db
CHROMADB_PERSIST_DIRECTORY=./data/chroma_db

# Audio Cache Configuration
AUDIO_CACHE_DIR=./data/audio_cache
AUDIO_CACHE_MAX_SIZE_MB=500

# Performance Settings
MAX_CONCURRENT_REQUESTS=5
API_TIMEOUT_SECONDS=30
MEMORY_RETRIEVAL_LIMIT=10

# Development Settings
DEBUG_MODE=false
MOCK_GEMINI=false
MOCK_TTS=false
