# Dynevi - Environment Configuration Template
# 
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# Never commit your .env file to version control!

# =============================================================================
# Gemini API Configuration
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
API_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# =============================================================================
# Text-to-Speech (TTS) Configuration
# =============================================================================
# TTS Provider: "pyttsx3" (offline), "gtts" (Google), "elevenlabs", "azure"
TTS_PROVIDER=pyttsx3

# Cloud TTS API Keys (optional - only needed for cloud providers)
# ElevenLabs API Key (if using ElevenLabs TTS)
ELEVENLABS_API_KEY=
# Google Cloud TTS Key (if using Google Cloud TTS)
GOOGLE_CLOUD_TTS_KEY=
# Azure Speech Services Key (if using Azure TTS)
AZURE_SPEECH_KEY=

# Audio cache configuration
AUDIO_CACHE_DIR=./data/audio_cache
AUDIO_CACHE_MAX_SIZE_MB=500

# =============================================================================
# ChromaDB Configuration
# =============================================================================
CHROMADB_PATH=./data/chroma_db
CHROMADB_PERSIST_DIRECTORY=./data/chroma_db

# =============================================================================
# LangSmith Tracing Configuration (Optional)
# =============================================================================
# Enable LangSmith tracing for API call visualization
# Get your API key from: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dynevi

# To enable LangSmith tracing:
# 1. Set LANGSMITH_TRACING=true
# 2. Set LANGSMITH_API_KEY to your LangSmith API key
# 3. (Optional) Set LANGSMITH_PROJECT to organize traces by project
#
# Example:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=dynevi-dev
#
# Benefits:
# - Visual dashboard for all API calls
# - Performance monitoring and latency tracking
# - Error debugging with full context
# - Cost tracking for API usage
# - Search and filter traces easily
#
# Your app works fine without LangSmith - tracing is optional!
# See README_TRACING.md for more details.

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG_MODE=false
MAX_CONCURRENT_REQUESTS=5
MEMORY_RETRIEVAL_LIMIT=10

# =============================================================================
# Development/Testing Mode
# =============================================================================
# Set to "true" to use mock services (no real API calls)
# Useful for offline development and testing
MOCK_GEMINI=false
MOCK_TTS=false

# =============================================================================
# Example Configurations
# =============================================================================
#
# Development Mode (with mocking):
#   MOCK_GEMINI=true
#   MOCK_TTS=true
#   ENVIRONMENT=development
#   DEBUG_MODE=true
#   LOG_LEVEL=DEBUG
#
# Production Mode:
#   ENVIRONMENT=production
#   DEBUG_MODE=false
#   LOG_LEVEL=INFO
#   MOCK_GEMINI=false
#   MOCK_TTS=false
#   LANGSMITH_TRACING=true  # Recommended for production monitoring
#
# Testing Mode (with LangSmith):
#   ENVIRONMENT=testing
#   MOCK_GEMINI=false  # Or true for offline tests
#   LANGSMITH_TRACING=true
#   LANGSMITH_PROJECT=dynevi-tests
